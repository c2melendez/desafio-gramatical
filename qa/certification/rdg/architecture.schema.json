{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_sha256",
    "source_manifest_sha256",
    "components",
    "blocks"
  ],
  "properties": {
    "schema_version": {
      "const": "7.8"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "decision",
          "purpose",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "REUSE",
              "EXTEND",
              "CREATE"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "reason",
          "depends_on",
          "subtopics"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "subtopics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "area",
                "topic",
                "subtopic"
              ],
              "properties": {
                "area": {
                  "type": "string",
                  "minLength": 1
                },
                "topic": {
                  "type": "string",
                  "minLength": 1
                },
                "subtopic": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
